# Copy to .env and fill in. Never commit .env.

# eBay Browse API (https://developer.ebay.com/)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_ENVIRONMENT=PRODUCTION  # or SANDBOX

# CPSC SaferProducts API (free, no key required for basic search)
CPSC_API_BASE=https://www.saferproducts.gov/RestWebServices/Recall

# DHL Express API (https://developer.dhl.com/)
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# Wise Business (for virtual card issuance later)
WISE_API_TOKEN=
WISE_PROFILE_ID=

# M-Pesa Daraja (KE buyer payments)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox

# Telegram (sourcing brief delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demand APIs
JIJI_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# FX rate source
FX_API_KEY=
FX_PROVIDER=openexchangerates  # or wise, exchangerate.host

# Storage
DATABASE_URL=sqlite:///./data/baby_arb.db

# Operating parameters (override defaults)
MARGIN_FLOOR_PCT=50
MAX_AUTO_BUY_USD=200
TARGET_SELL_THROUGH_DAYS=45
DEFAULT_CARSEAT_DOM_CEILING_YEARS=6
KE_DUTY_PCT=25
KE_VAT_PCT=16
KE_IDF_PCT=3.5
KE_RDL_PCT=2

# Logging
LOG_LEVEL=INFO
