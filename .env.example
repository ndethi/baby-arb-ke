# Copy to .env and fill in. Never commit .env.

# eBay Browse API (https://developer.ebay.com/)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_ENVIRONMENT=PRODUCTION  # or SANDBOX

# CPSC SaferProducts API (free, no key required for basic search)
CPSC_API_BASE=https://www.saferproducts.gov/RestWebServices/Recall

# DHL Express API (https://developer.dhl.com/)
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# Wise Business (for virtual card issuance later)
WISE_API_TOKEN=
WISE_PROFILE_ID=

# M-Pesa Daraja (KE buyer payments)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox

# Telegram (shop bot; the paused sourcing alerts also use it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demand APIs
JIJI_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

# FX rate source
FX_API_KEY=
FX_PROVIDER=openexchangerates  # or wise, exchangerate.host

# Marketing engine (docs/marketing/ENGINE_SPEC.md)
# TELEGRAM_BOT_TOKEN above is the shop bot (BotFather), not the Hermes bot.
TELEGRAM_ADMIN_IDS=            # comma-separated Telegram user IDs of the admins
TELEGRAM_OPS_CHAT_ID=          # "babyReShop Ops" group ID (negative number)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
# Model calls (marketing/llm.py). Free tiers: NVIDIA build.nvidia.com, OpenRouter :free
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_FALLBACK_PROVIDER=nvidia
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_REASONING=false
LLM_DAILY_CAP_USD=1
LLM_DAILY_CALL_CAP=200
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Rendering (Phase 1): photos in <dir>/raw, renders in <dir>/ready (gitignored)
MARKETING_ASSETS_DIR=assets
RENDER_BROWSER_CHANNEL=        # blank: bundled Chromium, then system Chrome
# Item lookup (Phase 2): Brave Search API, free tier (api-dashboard.search.brave.com)
BRAVE_SEARCH_API_KEY=
BRAVE_DAILY_CALL_CAP=50

# Storage (create or migrate with `baby-arb db upgrade`)
DATABASE_URL=sqlite:///./data/baby_arb.db

# Operating parameters (override defaults)
MARGIN_FLOOR_PCT=50
MAX_AUTO_BUY_USD=200
TARGET_SELL_THROUGH_DAYS=45
DEFAULT_CARSEAT_DOM_CEILING_YEARS=6
KE_DUTY_PCT=25
KE_VAT_PCT=16
KE_IDF_PCT=3.5
KE_RDL_PCT=2

# Logging
LOG_LEVEL=INFO
